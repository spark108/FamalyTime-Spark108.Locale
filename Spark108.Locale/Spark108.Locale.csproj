<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Spark108.Locale</AssemblyName>
    <RootNamespace>Spark108.Locale</RootNamespace>
    <GameManaged>../FamilyTime_Data/Managed</GameManaged>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UnityEngine.TextCoreFontEngineModule" HintPath="$(GameManaged)/UnityEngine.TextCoreFontEngineModule.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="../BepInEx/unstripped/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameManaged)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="../BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameManaged)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManaged)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(GameManaged)/UnityEngine.TextRenderingModule.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <None Update="locale/*.json"
          TargetPath="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="GenerateLocaleConfig" BeforeTargets="PrepareForBuild">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(IntermediateOutputPath)config.json"
                      Lines="{ &quot;language&quot;: &quot;ru_RU&quot; }"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Content Include="$(IntermediateOutputPath)config.json"
               TargetPath="config.json"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest" />
      <FileWrites Include="$(IntermediateOutputPath)config.json" />
    </ItemGroup>
  </Target>
</Project>
